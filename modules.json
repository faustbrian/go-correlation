      "purpose": "`correlation` is the transport-neutral owner of correlation, request, and causation identifiers. It carries those semantics through HTTP, JSON-RPC, queues, scheduled work, webhooks, logs, and OpenTelemetry without creating a global propagator or redefining trace and idempotency concepts.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "foundations",
      "family_label": "Foundations",
      "family_description": "Common immutable values, deterministic seams, configuration, identity propagation, and input validation.",
      "family_order": 1,
      "cohesion": {
        "family": "foundations",
        "secondary_capabilities": [
          "eventing-and-messaging",
          "http-and-service-edge",
          "identity-and-access",
          "observability",
          "transport-and-networking"
        ],
        "responsibility": "Provide immutable correlation, request, causation, and external identifiers with explicit trust and disclosure across transport boundaries.",
        "non_goals": [
          "Own trace or span identity, idempotency, tenancy, authentication, authorization, uniqueness, or replay protection.",
          "Provide a global propagator, process-wide registry, transport lifecycle, or observability backend."
        ],
        "public_package_identifier": "correlation",
        "primary_entry_packages": [
          "github.com/faustbrian/go-correlation"
        ],
        "package_selection": {
          "github.com/faustbrian/go-correlation": "Use for immutable correlation values, validated identifiers, trust policy, disclosure policy, and transport-neutral propagation.",
          "github.com/faustbrian/go-correlation/http": "Use for bounded inbound and outbound HTTP correlation with explicit proxy trust.",
          "github.com/faustbrian/go-correlation/http/requestidbridge": "Use to adopt a trusted go-http-middleware request identifier without sharing private context keys.",
          "github.com/faustbrian/go-correlation/jsonrpc": "Use for explicit correlation metadata alongside JSON-RPC envelopes.",
          "github.com/faustbrian/go-correlation/log": "Use for bounded redacted, keyed-hash, or explicitly raw slog attributes.",
          "github.com/faustbrian/go-correlation/queue": "Use to preserve workflow identity while rotating request identity for each queue delivery attempt.",
          "github.com/faustbrian/go-correlation/schedule": "Use to create or deliberately propagate correlation values for scheduled runs.",
          "github.com/faustbrian/go-correlation/telemetry": "Use to attach bounded correlation attributes and links to caller-owned OpenTelemetry data.",
          "github.com/faustbrian/go-correlation/webhook": "Use for explicit outbound and inbound webhook correlation over HTTP."
        },
